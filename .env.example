# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real API key.

# Option A (recommended): Google Gemini free tier
# Get your key at https://aistudio.google.com → "Get API key"
# Model used: gemini-flash-lite-latest (free tier, no billing required)
GEMINI_API_KEY=

# Option B: Anthropic API (requires credits at console.anthropic.com)
# Model used: claude-haiku-4-5-20251001
# Cost estimate: < $0.001 per query
ANTHROPIC_API_KEY=

# If neither key is set, the system runs in retrieval-only mode:
# it returns the top retrieved chunk with full source citations.
